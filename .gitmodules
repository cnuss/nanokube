[submodule "tests"]
	path = tests
	url = https://github.com/cnuss/chainsaw-kube.git
	branch = main
	shallow = true
	ignore = dirty
[submodule "cri-tools"]
	path = cri-tools
	url = https://github.com/kubernetes-sigs/cri-tools.git
	branch = master
	shallow = true
	ignore = dirty
[submodule "kubernetes"]
	path = kubernetes
	url = https://github.com/kubernetes/kubernetes.git
	branch = release-1.35
	shallow = true
	ignore = dirty
